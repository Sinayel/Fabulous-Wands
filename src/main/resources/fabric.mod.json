{
	"schemaVersion": 1,
	"id": "fabulous-wands",
	"version": "${version}",
	"name": "Fabulous Wands",
	"description": "Fabulous Wands is a Minecraft mod that adds magic wands, inspired by Harry Potter, cast spells, wear wizard armor and more !",
	"authors": [
		"Sinayel"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/fabulous-wands/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"tech.sinayel.fabulouswands.FabulousWands"
		],
		"fabric-datagen": [
			"tech.sinayel.fabulouswands.FabulousWandsDataGenerator"
		],
		"client": [
			"tech.sinayel.fabulouswands.FabulousWandsClient"
		]
	},
	"mixins": [
		"fabulous-wands.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}